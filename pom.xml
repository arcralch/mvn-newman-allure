<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>mvn-newman-allure</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- Ruta correcta para Linux -->
        <allure.results.directory>target/allure-results</allure.results.directory>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <maven.compiler.release>11</maven.compiler.release>

        <!-- Configuración de SonarCloud -->
        <sonar.organization>arcralch</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.token>${env.SONAR_TOKEN}</sonar.token>
        <sonar.projectKey>mvn-newman-allure</sonar.projectKey>
        <sonar.projectName>mvn-newman-allure</sonar.projectName>
    </properties>

    <build>
        <plugins>

            <!-- Limpia resultados anteriores -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <?m2e execute onConfiguration?>
                        <id>clean-allure</id>
                        <phase>initialize</phase>
                        <configuration>
                            <target>
                                <delete dir="${allure.results.directory}" quiet="true"/>
                                <mkdir dir="${allure.results.directory}"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Ejecuta pruebas Postman con Newman -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>run-newman</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>

                            <workingDirectory>${project.basedir}</workingDirectory>

                            <!-- FIX PRINCIPAL -->
                            <executable>newman</executable>

                            <arguments>
                                <argument>run</argument>
                                <argument>src/test/java/postman/pokemon.postman_collection.json</argument>

                                <argument>--iteration-count</argument>
                                <argument>1</argument>

                                <argument>-r</argument>
                                <argument>allure</argument>

                                <argument>--reporter-allure-resultsDir</argument>
                                <argument>target/allure-results</argument>
                            </arguments>

                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Allure report -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>2.12.0</version>
                <configuration>
                    <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-allure-environment</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/allure-results</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/test/java/resources</directory>
                                    <filtering>true</filtering>
                                    <includes>
                                        <include>environment.properties</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Plugin oficial para el análisis de SonarCloud -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>3.9.1.2184</version>
                <executions>
                        <execution>
                            <phase>none</phase>
                            <goals>
                                <goal>sonar</goal>
                            </goals>
                        </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>